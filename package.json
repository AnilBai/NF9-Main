{
  "name": "nf9",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "minifyHtml": false,
    "crawl": true,
    "inlineCss": false,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "routes": [
      "/",
      "/services",
      "/contact-us"
    ]
  },
  "dependencies": {
    "framer-motion": "^12.26.1",
    "gsap": "^3.14.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.7",
    "vite-ssg": "^28.3.0"
  }
